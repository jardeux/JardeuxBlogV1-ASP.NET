@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model List<Comment>

<div class="d-sm-flex align-items-center justify-content-between mb-4">
    <h1 class="h3 mb-0 text-gray-800">Yorumlarım</h1>
</div>

@foreach (var item in Model.OrderByDescending(u => u.Id))
{
    <div class="card shadow mb-4">
        <!-- Card Header - Dropdown -->
        <div class="card-header py-3 d-flex flex-row align-items-center justify-content-between">
            <h6 class="m-0 font-weight-bold text-primary">@item.Name - @item.PublishDate.ToString("MM/dd HH/mm")</h6>
            <div class="dropdown no-arrow">
                <a class="dropdown-toggle" href="#" role="button" id="dropdownMenuLink"
                   data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                    <i class="fas fa-ellipsis-v fa-sm fa-fw text-gray-400"></i>
                </a>
                <div class="dropdown-menu dropdown-menu-right shadow animated--fade-in"
                     aria-labelledby="dropdownMenuLink">
                    <div class="dropdown-header">Seçenekler:</div>
                    <a class="dropdown-item" asp-controller="Blogs" asp-action="Details" asp-route-Id="@item.BlogId">İlgili Bloga Git</a>
                   <div class="dropdown-divider"></div>
                    <a class="dropdown-item" asp-action="DeleteComment" asp-route-Id="@item.Id">Yorumu Sil</a>
                </div>
            </div>
        </div>
        <!-- Card Body -->
        <div class="card-body">
            @item.Message - @item.Email
        </div>
    </div>

}
